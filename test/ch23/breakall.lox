// Test 5
print("john");
print("NEW LOOP");
print("");
var i = 0;
var N = 2;
while (i < N) {
    var j = 0;
    var M = 2;
    print "loop 0 outer";
    print("i: " + i);
    while (j < M) {
        print "loop 0 inner";
        print("j: " + j);
        breakall;
        j = j + 1;
    }
    i = i + 1;
    print "unreachable";
}


