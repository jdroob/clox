// break out from innermost loop

var i = 0;
var N_OUTER = 2;
while (i < N_OUTER) {
    var N_INNER = 2;
    var j = 0;
    print("outer");
    print("i: " + i);
    while (j < N_INNER) {
        print("inner");
        print("j: " + j);
        breakall;  // SHOULD EXIT HERE
        j = j + 1;  // UNREACHABLE
    }
    i = i + 1;  // UNREACHABLE
}